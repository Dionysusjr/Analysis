# --- Stock price data source -------------------------------------------
# One of: mock | scrape | mdf
#   mock   - built-in simulator (default). Works with zero setup, seeded
#            from realistic reference prices/sectors/yields so the UI is
#            immediately useful. Clearly labeled "SIMULATED" in the UI.
#   scrape - best-effort HTML scraper against jamstockex.com public market
#            data pages. No credentials needed, but JSE's site sits behind
#            bot protection and can change markup without notice - treat
#            this as best-effort, not guaranteed uptime.
#   mdf    - Jamaica Stock Exchange's official real-time Market Data Feed
#            API (see https://www.jamstockex.com/services/api-services/).
#            This is the only source with true exchange-grade real-time
#            data. Request access from JSE, then fill in the values below.
STOCK_DATA_SOURCE=mock

# Required only when STOCK_DATA_SOURCE=mdf
JSE_MDF_BASE_URL=
JSE_MDF_API_KEY=

# How often the browser polls the API routes, in milliseconds.
NEXT_PUBLIC_STOCK_POLL_MS=30000
NEXT_PUBLIC_NEWS_POLL_MS=300000
